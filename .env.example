# Порты на хосте
API_PORT=8000
WEBHOOK_RECEIVER_PORT=8001
RABBITMQ_UI_PORT=15672

# Postgres
POSTGRES_USER=billing
POSTGRES_PASSWORD=billing
POSTGRES_DB=billing

# Приложение
API_KEY=change-me
DATABASE_URL=postgresql+asyncpg://billing:billing@postgres:5432/billing
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Outbox
OUTBOX_POLL_INTERVAL=1.0
OUTBOX_BATCH_SIZE=100

# Consumer
CONSUMER_PREFETCH_COUNT=10
MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=1000
WEBHOOK_TIMEOUT=5.0

# Эмулятор шлюза
GATEWAY_MIN_DELAY=2.0
GATEWAY_MAX_DELAY=5.0
GATEWAY_SUCCESS_RATE=0.9

# Mock webhook-receiver: доля ответов 500
WEBHOOK_RECEIVER_FAIL_RATE=0.0
